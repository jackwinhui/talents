# Plaid — Production credentials from dashboard.plaid.com
# Trial plan: 10 Items total. Removing an Item does NOT free a slot.
# Do NOT upgrade off Trial — Fidelity then requires a manual request with no SLA.
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENV=production

# Server — loopback only; use Tailscale for phone access.
HOST=127.0.0.1
PORT=8787

# Categorizer: ~200 local merchant rules run offline. LLM fallback is opt-in and
# only ever sees an unknown merchant string.
ENABLE_LLM_CATEGORIZER=false
